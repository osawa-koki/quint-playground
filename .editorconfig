root = true

# 既定はスペース 4 つ（Python・シェルなど）
[*]
indent_style = space
indent_size = 4
end_of_line = lf
charset = utf-8
trim_trailing_whitespace = true
insert_final_newline = true

[*.md]
trim_trailing_whitespace = false

# YAML（GitHub Actions）・JSON・JSONC は、スペース 2 つ
[*.{yml,yaml,json,jsonc}]
indent_size = 2
